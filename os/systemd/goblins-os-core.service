[Unit]
Description=Goblins OS local AI service core
After=network-online.target
Wants=network-online.target
# Every Settings/status surface depends on this daemon; a one-off death must
# never become a permanent outage through restart rate limiting.
StartLimitIntervalSec=0

[Service]
Type=simple
User=goblins-os
Group=goblins-os
SupplementaryGroups=goblins-session-bridge goblins-snapshot-readers goblins-core-resident
EnvironmentFile=-/etc/goblins-os/environment
# Build Studio's Codex CLI account state is core-private. Never export this path
# through the shared desktop environment: any compatible desktop app owns its
# own user session and must not inherit the service account's CODEX_HOME.
Environment=CODEX_HOME=/var/lib/goblins-os/codex
LoadCredential=openai-secrets.env:/etc/goblins-os/openai-secrets.env
ExecStart=/usr/libexec/goblins-os/goblins-os-core
Restart=always
RestartSec=2s
# Back off toward a calm retry cadence when the failure persists; the unit
# keeps retrying (never latches failed) without flooding the journal.
RestartSteps=8
RestartMaxDelaySec=60
StateDirectory=goblins-os/models goblins-os/ai goblins-os/policy
StateDirectoryMode=0750
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=-/.snapshots -/var/.snapshots -/var/home/.snapshots
ReadWritePaths=/run/goblins-os-core /var/lib/goblins-os/installer /var/lib/goblins-os/session /var/lib/goblins-os/policy /var/lib/goblins-os/ai /var/lib/goblins-os/models /var/lib/goblins-os/voice/work /var/lib/goblins-os/secrets/openai /var/lib/goblins-os/apps /var/lib/goblins-os/codex
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
